   "height": 34,
   "paddingLeft": 14,
   "draggable": true
  },
  "title": {
   "fontSize": 12
  },
  "badge": {
   "fontSize": 11,
   "radius": 3,
   "paddingX": 7,
   "paddingY": 2,
   "marginLeft": 10
