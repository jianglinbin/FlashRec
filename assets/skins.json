   "trackHeight": 3,
   "radius": 2,
   "knobSize": 13,
   "knobSizeHover": 18,
   "knobHaloSizeDrag": 26,
   "chapterTickWidth": 2,
   "chapterTickHeight": 11
  },
  "thumbPreview": {
   "width": 96,
   "height": 54,
   "radius": 6,
   "gapAboveProgress": 30
  },
  "volumeBar": {
   "width": 76,
   "height": 4,
   "iconSize": 13,
   "knobSize": 11,
   "knobSizeHover": 15,
   "hitPad": 8
  },
  "speedControl": {
   "fontSize": 11,
   "buttonWidth": 40,
   "itemHeight": 24,
   "menuPadY": 5,
   "presets": [
    0.5,
    0.75,
    1.0,
    1.25,
    1.5,
    2.0,
    3.0
   ]
  },
  "timeText": {
   "fontSize": 11
  },
  "motion": {
   "idleHideMs": 2500,
   "fadeMs": 300,
   "hoverFadeMs": 120,
   "pressFadeMs": 70,
   "pressScale": 0.92,
   "dblClickMs": 300
  },
  "playButtonCenter": {
   "size": 56,
   "iconSize": 16
  }
 },
