  },
  "thumbPreview": {
   "width": 96,
   "height": 54,
   "radius": 6,
   "gapAboveProgress": 30,
   "anchor": "进度点（left:P%; translateX(-50%)）"
  },
  "volumeBar": {
   "width": 76,
   "height": 4,
   "iconSize": 13,
   "knobSize": 11,
   "knobSizeHover": 15,
   "hitPad": 8
  },
  "timeText": {
   "fontSize": 11,
   "fontVariantNumeric": "tabular-nums"
  },
  "icons": {
   "playPause": "10x12",
   "prevNext": "12x11",
   "pip": "12x11",
   "fullscreen": "12x12",
   "volume": "13x11",
   "separator": "1x14"
  },
  "motion": {
   "idleHideMs": 2000,
   "fadeMs": 300,
   "hoverFadeMs": 120,
   "pressFadeMs": 70,
   "pressScale": 0.92,
   "dblClickMs": 300
  },
  "playButtonCenter": {
   "size": 56,
   "iconSize": 16
  }
 },
