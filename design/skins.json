{
 "meta": {
  "name": "FlashRec 播放态皮肤 token",
  "version": "1.0",
  "date": "2026-09-15",
  "scope": "播放态（PLAYING / PAUSED_PLAYBACK / TRANSITIONING）界面皮肤",
  "skeleton": "统一骨架，不可变：IINA/macOS 排版（无边框 + 上下两条贴边半透明栏 + 不操作自动隐去 + 悬停时间线出缩略图）+ Windows 习惯右上角三键",
  "note": "切换皮肤只替换 colors / shape 两组 token，不改任何布局尺寸。ui/theme.h 应实现为 Theme 结构体，不要散落常量。",
  "pending": [
   "待机态（等待投屏）尚未设计 —— 接收端 95% 时间处在此状态，主流播放器无此场景可参考，需原创",
   "默认皮肤未最终指定（用户尚未拍板，6 套全部保留）"
  ],
  "tokenNotes": {
   "topBarBg": "顶栏不透明底色（窗口模式顶栏常显、不自动隐藏、不半透明）",
   "barBg": "半透明栏底色，仅底栏使用（底栏可半透明、可自动隐藏）",
   "windowRadius": "窗口模式圆角；全屏与最大化一律直角（运行时判定，不改 token）"
  }
 },
